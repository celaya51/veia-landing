---
const tarjetas = [
  { num: "01", titulo: "No apareces en Google", texto: "La gente te busca en el celular y no te encuentra (ni en el mapa)." },
  { num: "02", titulo: "No tienes página web", texto: "O la que tienes está vieja y no se ve bien en el teléfono." },
  { num: "03", titulo: "Tus redes están dormidas", texto: "Sin publicaciones ni quién responda los mensajes de tus clientes." },
];
---

<section class="seccion" id="problema">
  <div class="contenedor">
    <div class="revelar">
      <span class="antetitulo">¿Te suena?</span>
      <h2>Si tu negocio no está en internet, están encontrando… a tu competencia.</h2>
    </div>
    <div class="v-rejilla v-rejilla--3 revelar" style="margin-top:2.6rem">
      {tarjetas.map((t) => (
        <article class="v-tarjeta">
          <span class="v-tarjeta__num">{t.num}</span>
          <h3>{t.titulo}</h3>
          <p>{t.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>
