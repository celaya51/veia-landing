---
const pasos = [
  { num: "01", titulo: "Platicamos", texto: "Entendemos tu negocio y qué necesitas. En español claro, sin tecnicismos." },
  { num: "02", titulo: "Lo hacemos contigo", texto: "Avanzamos paso a paso. Aprendes en el camino y quedas al mando." },
  { num: "03", titulo: "Quedas listo", texto: "Tu negocio en internet, con apoyo nuestro cuando lo necesites." },
];
---

<section class="seccion" id="como">
  <div class="contenedor revelar">
    <span class="antetitulo">Sin complicaciones</span>
    <h2>Cómo trabajamos</h2>
    <div class="v-pasos" style="margin-top:2.2rem">
      {pasos.map((p) => (
        <div class="v-paso">
          <span class="v-paso__num">{p.num}</span>
          <h3>{p.titulo}</h3>
          <p style="max-width:46em">{p.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
