---
const base = import.meta.env.BASE_URL;
const clientes = [
  { nombre: "SANHER Bienes Raíces", logo: `${base}images/logo-sanher.svg`, href: "https://sanherbienesraices.com/" },
  { nombre: "Legend Horizon Living", logo: `${base}images/logo-legend.webp`, href: "https://legendtower.com.mx/" },
  { nombre: "Uditore", logo: `${base}images/logo-uditore-full.png`, href: "https://uditore.mx/" },
  { nombre: "Tocomadera", logo: `${base}images/logo-tocomadera.png`, href: "https://tocomadera.mx/" },
  { nombre: "Ascendia", logo: `${base}img/ascendia-logo.png`, href: "https://ascendia.mx/", oscuro: true },
];
---

<section class="seccion seccion--gris" id="clientes">
  <div class="contenedor">
    <div class="revelar">
      <span class="antetitulo">Trabajo real</span>
      <h2>Negocios que ya tienen presencia digital</h2>
    </div>
    <div class="v-clientes revelar" style="margin-top:2.4rem">
      {clientes.map((c) => (
        <a class:list={["v-cliente", c.oscuro && "v-cliente--oscuro"]} href={c.href} target="_blank" rel="noopener">
          <img src={c.logo} alt={c.nombre} loading="lazy" />
        </a>
      ))}
    </div>
    <div class="revelar" style="margin-top:2.2rem;text-align:center">
      <a class="boton boton--contorno" href={`${base}portafolio/`}>Ver portafolio</a>
    </div>
  </div>
</section>
